{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@autoverse/ui", "storybook"],
      "port": 6006
    },
    {
      "name": "consumer",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@autoverse/consumer", "dev"],
      "port": 3000
    },
    {
      "name": "consumer-fixture",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "require(\"child_process\").spawn(\"pnpm\",[\"--filter\",\"@autoverse/consumer\",\"dev\"],{stdio:\"inherit\",shell:true,env:{...process.env,CONSUMER_ROOT_DOMAIN:\"localhost\",SHOWROOM_SOURCE:\"fixture\"}}).on(\"exit\",c=>process.exit(c??0))"
      ],
      "port": 3000
    }
  ]
}
