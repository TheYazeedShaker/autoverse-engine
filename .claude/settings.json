{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/secret-scan.sh"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__.*__(apply_migration|execute_sql|deploy_edge_function|list_migrations|list_tables|list_extensions|list_edge_functions|get_edge_function|get_advisors|query_logs|get_logs|generate_typescript_types|get_publishable_keys|get_project_url|create_branch|delete_branch|merge_branch|reset_branch|rebase_branch|list_branches|restore_project|confirm_cost|get_cost|list_organizations|get_organization|pause_project|create_project|get_project|list_projects|merge_pull_request|enable_pr_auto_merge|pull_request_review_write|push_files|create_or_update_file|delete_file)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install*)",
      "Bash(pnpm build*)",
      "Bash(pnpm test*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm format*)",
      "Bash(pnpm --filter * build*)",
      "Bash(pnpm --filter * test*)",
      "Bash(pnpm --filter * lint*)",
      "Bash(pnpm --filter * typecheck*)",
      "Bash(npx prettier *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash*)",
      "Bash(git restore *)",
      "Bash(git rebase origin/main*)",
      "Bash(git merge origin/main*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(supabase start*)",
      "Bash(supabase stop*)",
      "Bash(supabase status*)",
      "Bash(supabase db start*)",
      "Bash(supabase db reset*)",
      "Bash(supabase test db*)",
      "Bash(supabase migration new *)",
      "Bash(supabase functions serve*)",
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(git push)",
      "Read(./.env.example)"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push -f*)",
      "Bash(git push * +*)",
      "PowerShell(git push*)",
      "Bash(supabase link*)",
      "Bash(supabase login*)",
      "Bash(supabase projects*)",
      "Bash(supabase orgs*)",
      "Bash(supabase db push*)",
      "Bash(supabase db pull*)",
      "Bash(supabase db dump*)",
      "Bash(supabase migration list*)",
      "Bash(supabase migration repair*)",
      "Bash(supabase migration fetch*)",
      "Bash(supabase functions deploy*)",
      "Bash(supabase functions delete*)",
      "Bash(supabase functions download*)",
      "Bash(supabase secrets*)",
      "Bash(supabase config push*)",
      "Bash(supabase branches*)",
      "Bash(supabase backups*)",
      "Bash(supabase inspect*)",
      "Bash(supabase storage*)",
      "Bash(supabase postgres-config*)",
      "Bash(supabase sso*)",
      "Bash(supabase domains*)",
      "Bash(supabase vanity-subdomains*)",
      "Bash(supabase network-*)",
      "Bash(supabase ssl-*)",
      "Bash(supabase *--linked*)",
      "Bash(supabase *--db-url*)",
      "Bash(supabase *--project-ref*)",
      "Bash(supabase *--project-id*)",
      "Bash(psql*supabase.co*)",
      "Bash(psql*supabase.com*)",
      "PowerShell(supabase*)",
      "PowerShell(psql*)",
      "Bash(gh api*)",
      "Bash(gh ruleset*)",
      "Bash(gh repo edit*)",
