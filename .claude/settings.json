      "Edit(./.claude/settings.local.json)",
      "Write(./.claude/settings.local.json)",
      "Edit(./.claude/hooks/**)",
      "Write(./.claude/hooks/**)",
      "Edit(./.mcp.json)",
      "Write(./.mcp.json)",
      "Edit(./specs/SPEC-autonomous-loop.md)",
      "Write(./specs/SPEC-autonomous-loop.md)"
    ]
  }
}
