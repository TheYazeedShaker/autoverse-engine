      "Read(./.env.*.local)",
      "Read(./.env.production*)",
      "Read(./.env.staging*)",
      "Read(./.env.development*)",
      "Read(./.env.test*)",
      "Read(./.envrc)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./supabase/.env*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Edit(./**/.env*)",
      "Write(./**/.env*)",
      "Read(./design/**)",
      "Edit(./design/**)",
      "Write(./design/**)",
      "Edit(./.github/**)",
      "Write(./.github/**)",
      "Edit(./.claude/settings.json)",
