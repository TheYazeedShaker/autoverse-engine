# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only, never exposed to the client

# ---- PostHog (analytics + flags + replay) ----
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com   # match the region you chose

# ---- Sentry ----
NEXT_PUBLIC_SENTRY_DSN=            # public DSN; used by client + server SDK init
SENTRY_DSN=                        # optional server-only fallback DSN
SENTRY_AUTH_TOKEN=                 # later: source-map upload (withSentryConfig)

# ---- Configurator ----
NEXT_PUBLIC_AUTOVERSE_ORIGIN=https://autoverse.app   # used for postMessage targetOrigin
